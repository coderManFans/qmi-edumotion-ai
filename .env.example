APP_ENV=development
APP_NAME=EduMotion AI
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
POSTGRES_DB=edumotion
POSTGRES_USER=edumotion
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://edumotion:change-me@localhost:5432/edumotion
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES_SECONDS=604800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=960
STORAGE_ROOT=./storage

# Optional OpenAI-compatible Chat Completions endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Chinese TTS (Edge neural voices; no API key, requires outbound internet)
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%

# Local MP4 rendering (FFmpeg must be installed)
FFMPEG_BIN=ffmpeg
VIDEO_OUTPUT_DIR=./data/renders
VIDEO_FPS=12
VIDEO_SCENE_SECONDS=3
