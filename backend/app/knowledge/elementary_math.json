{
  "schema_version": "1.0",
  "source_basis": "《义务教育数学课程标准（2022年版）》小学阶段知识领域；公式与题型为工程整理的教学知识库，不替代具体教材版本。",
  "grade_bands": [
    {
      "id": "G1_2",
      "grades": [
        1,
        2
      ],
      "focus": [
        "数的认识与运算",
        "加减乘除意义",
        "长度、时间、人民币",
        "简单图形与分类",
        "生活中的数据记录"
      ]
    },
    {
      "id": "G3_4",
      "grades": [
        3,
        4
      ],
      "focus": [
        "多位数四则运算",
        "小数和分数初步",
        "常见数量关系",
        "长度面积周长",
        "角、方向、统计图表"
      ]
    },
    {
      "id": "G5_6",
      "grades": [
        5,
        6
      ],
      "focus": [
        "小数分数百分数运算",
        "比和比例的初步应用",
        "速度时间路程",
        "平面图形面积",
        "圆、体积、单位换算、统计与可能性"
      ]
    }
  ],
  "problem_families": [
    {
      "id": "additive_change",
      "name": "加减应用题（合并与变化）",
      "grades": [
        1,
        2,
        3
      ],
      "concepts": [
        "部分与整体",
        "增加与减少",
        "已知两部分求整体",
        "已知整体和一部分求另一部分"
      ],
      "relations": [
        "总量=部分1+部分2",
        "剩余=原有-用去",
        "变化后=原量±变化量"
      ],
      "cues": [
        "一共",
        "合起来",
        "总共",
        "还剩",
        "剩下",
        "用去",
        "送给",
        "拿走"
      ],
      "guardrails": [
        "必须区分原有量、增加量、减少量和所求量",
        "不能仅看到‘多’或‘少’就直接确定运算方向"
      ]
    },
    {
      "id": "multiplicative",
      "name": "乘除应用题（倍数与平均分）",
      "grades": [
        2,
        3,
        4
      ],
      "concepts": [
        "几个相同加数的和",
        "平均分",
        "包含除",
        "倍数关系"
      ],
      "relations": [
        "总数=每份数×份数",
        "每份数=总数÷份数",
        "份数=总数÷每份数",
        "比较量=标准量×倍数"
      ],
      "cues": [
        "每个",
        "每份",
        "平均分",
        "每人",
        "每组",
        "几倍",
        "是……的几倍"
      ],
      "guardrails": [
        "平均分必须明确总量和份数",
        "‘是几倍’需识别标准量与比较量，不能按数字出现顺序猜测"
      ]
    },
    {
      "id": "unit_price",
      "name": "单价、数量与总价",
      "grades": [
        3,
        4,
        5
      ],
      "concepts": [
        "单价",
        "数量",
        "总价"
      ],
      "formulas": [
        {
          "name": "总价",
          "formula": "总价=单价×数量"
        },
        {
          "name": "单价",
          "formula": "单价=总价÷数量"
        },
        {
          "name": "数量",
          "formula": "数量=总价÷单价"
        }
      ],
      "guardrails": [
        "金额单位统一为元或分后再计算",
        "单价和总价不能混淆"
      ]
    },
    {
      "id": "distance_speed_time",
      "name": "行程问题",
      "grades": [
        4,
        5,
        6
      ],
      "concepts": [
        "路程",
        "速度",
        "时间"
      ],
      "formulas": [
        {
          "name": "路程",
          "formula": "路程=速度×时间"
        },
        {
          "name": "速度",
          "formula": "速度=路程÷时间"
        },
        {
          "name": "时间",
          "formula": "时间=路程÷速度"
        }
      ],
      "guardrails": [
        "统一千米/小时与小时，或米/秒与秒",
        "往返、相遇、追及不能直接套单程公式，需要额外关系"
      ]
    },
    {
      "id": "average",
      "name": "平均数问题",
      "grades": [
        4,
        5,
        6
      ],
      "concepts": [
        "总数量",
        "份数",
        "平均数"
      ],
      "formulas": [
        {
          "name": "平均数",
          "formula": "平均数=总数量÷总份数"
        },
        {
          "name": "总数量",
          "formula": "总数量=平均数×总份数"
        }
      ],
      "guardrails": [
        "平均数不一定等于某个实际数据",
        "合并两组平均数时必须按人数/份数加权"
      ]
    },
    {
      "id": "fraction",
      "name": "分数问题",
      "grades": [
        3,
        4,
        5,
        6
      ],
      "concepts": [
        "单位‘1’",
        "分数意义",
        "分数与数量关系"
      ],
      "relations": [
        "部分量=整体量×对应分率",
        "整体量=部分量÷对应分率",
        "已知部分量和对应分率：单位“1”=部分量÷对应分率"
      ],
      "guardrails": [
        "必须明确单位‘1’是谁",
        "分率对应的整体不同，不能直接相加减",
        "同一道题中若出现多个整体，必须确认分率分别对应哪个整体"
      ]
    },
    {
      "id": "percentage",
      "name": "百分数问题",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "百分率",
        "百分数与分数、小数互化",
        "折扣、税率、增长率"
      ],
      "formulas": [
        {
          "name": "求一个数的百分之几",
          "formula": "部分量=整体量×百分率"
        },
        {
          "name": "求百分率",
          "formula": "百分率=部分量÷整体量×100%"
        },
        {
          "name": "折后价",
          "formula": "现价=原价×折扣率"
        },
        {
          "name": "增长后数量",
          "formula": "现量=原量×(1+增长率)"
        },
        {
          "name": "已知部分量求整体量",
          "formula": "整体量=部分量÷百分率"
        },
        {
          "name": "增长后反求原量",
          "formula": "原量=现量÷(1+增长率)"
        },
        {
          "name": "降低后反求原量",
          "formula": "原量=现量÷(1-降低率)"
        }
      ],
      "guardrails": [
        "增长率、降低率、折扣率的基准量必须明确",
        "百分数计算后要检查是否符合语境范围"
      ]
    },
    {
      "id": "ratio_proportion",
      "name": "比和比例应用",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "比的意义",
        "比值",
        "按比分配",
        "比例尺"
      ],
      "relations": [
        "比的前项和后项同时乘或除以相同非零数，比值不变",
        "按比分配：每份量=总量÷各项份数和"
      ],
      "guardrails": [
        "比的顺序不可颠倒",
        "按比分配时先求份数和，再求每份量"
      ]
    },
    {
      "id": "square",
      "name": "正方形周长与面积",
      "grades": [
        3,
        4,
        5
      ],
      "concepts": [
        "边长",
        "周长",
        "面积"
      ],
      "formulas": [
        {
          "name": "周长",
          "formula": "C=4a"
        },
        {
          "name": "边长（已知周长）",
          "formula": "a=C÷4"
        },
        {
          "name": "面积",
          "formula": "S=a×a"
        },
        {
          "name": "边长（已知面积）",
          "formula": "a=√S"
        }
      ],
      "guardrails": [
        "周长单位是长度单位，面积单位是平方单位",
        "边长必须非负"
      ]
    },
    {
      "id": "rectangle",
      "name": "长方形周长与面积",
      "grades": [
        3,
        4,
        5
      ],
      "concepts": [
        "长",
        "宽",
        "周长",
        "面积"
      ],
      "formulas": [
        {
          "name": "周长",
          "formula": "C=2(a+b)"
        },
        {
          "name": "长",
          "formula": "a=C÷2-b"
        },
        {
          "name": "宽",
          "formula": "b=C÷2-a"
        },
        {
          "name": "面积",
          "formula": "S=ab"
        },
        {
          "name": "宽（已知面积和长）",
          "formula": "b=S÷a"
        },
        {
          "name": "长（已知面积和宽）",
          "formula": "a=S÷b"
        }
      ],
      "guardrails": [
        "周长与面积不可混用",
        "周长已知且只给一个边长时，才能反求另一个边长"
      ]
    },
    {
      "id": "triangle",
      "name": "三角形面积",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "底",
        "高",
        "面积"
      ],
      "formulas": [
        {
          "name": "面积",
          "formula": "S=底×高÷2"
        },
        {
          "name": "底",
          "formula": "底=面积×2÷高"
        },
        {
          "name": "高",
          "formula": "高=面积×2÷底"
        }
      ],
      "guardrails": [
        "高必须是对应底边上的垂直距离",
        "单位使用平方单位"
      ]
    },
    {
      "id": "parallelogram",
      "name": "平行四边形面积",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "底",
        "高",
        "面积"
      ],
      "formulas": [
        {
          "name": "面积",
          "formula": "S=底×高"
        }
      ],
      "guardrails": [
        "高必须垂直于底边，不是斜边长度"
      ]
    },
    {
      "id": "trapezoid",
      "name": "梯形面积",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "上底",
        "下底",
        "高",
        "面积"
      ],
      "formulas": [
        {
          "name": "面积",
          "formula": "S=(上底+下底)×高÷2"
        }
      ],
      "guardrails": [
        "上底、下底是平行的两条边",
        "高是两底之间的垂直距离"
      ]
    },
    {
      "id": "circle",
      "name": "圆的周长与面积",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "半径",
        "直径",
        "圆周率π"
      ],
      "formulas": [
        {
          "name": "直径",
          "formula": "d=2r"
        },
        {
          "name": "周长",
          "formula": "C=πd=2πr"
        },
        {
          "name": "面积",
          "formula": "S=πr²"
        }
      ],
      "guardrails": [
        "半径与直径不可混淆",
        "π取值精度应明确，默认3.14时注明近似",
        "周长是长度单位，面积是平方单位"
      ]
    },
    {
      "id": "cuboid",
      "name": "长方体与正方体",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "长、宽、高",
        "表面积",
        "体积",
        "容积"
      ],
      "formulas": [
        {
          "name": "长方体体积",
          "formula": "V=长×宽×高"
        },
        {
          "name": "正方体体积",
          "formula": "V=a³"
        },
        {
          "name": "长方体表面积",
          "formula": "S=2(ab+ah+bh)"
        },
        {
          "name": "正方体表面积",
          "formula": "S=6a²"
        }
      ],
      "guardrails": [
        "体积单位是立方单位",
        "容积与体积单位换算要一致",
        "表面积与体积不可混淆"
      ]
    },
    {
      "id": "unit_conversion",
      "name": "常见单位换算",
      "grades": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "concepts": [
        "长度",
        "面积",
        "质量",
        "时间",
        "人民币",
        "体积与容积"
      ],
      "relations": [
        "1千米=1000米",
        "1米=10分米=100厘米=1000毫米",
        "1平方米=100平方分米=10000平方厘米",
        "1公顷=10000平方米",
        "1平方千米=100公顷",
        "1吨=1000千克",
        "1千克=1000克",
        "1小时=60分钟",
        "1分钟=60秒",
        "1升=1000毫升",
        "1立方米=1000立方分米=1000000立方厘米",
        "1立方分米=1升=1000毫升",
        "1小时=60分钟=3600秒",
        "速度单位换算先统一路程单位和时间单位，例如1米/秒=3.6千米/小时"
      ],
      "guardrails": [
        "面积单位换算按进率平方，体积单位换算按进率立方",
        "时间单位进率不都是十进制",
        "复合单位（如千米/小时）必须同时换算分子和分母，不能只换算其中一个单位"
      ]
    },
    {
      "id": "statistics",
      "name": "统计与平均数",
      "grades": [
        3,
        4,
        5,
        6
      ],
      "concepts": [
        "分类整理",
        "统计表",
        "条形图",
        "折线图",
        "平均数"
      ],
      "relations": [
        "平均数=总和÷数据个数"
      ],
      "guardrails": [
        "读图必须先确认横轴、纵轴、单位和刻度",
        "不得从图表中推断未提供的数据"
      ]
    },
    {
      "id": "probability",
      "name": "可能性初步",
      "grades": [
        5,
        6
      ],
      "concepts": [
        "随机现象",
        "可能性大小",
        "等可能"
      ],
      "relations": [
        "在等可能且样本空间有限时，可能性=符合条件的情况数÷总情况数"
      ],
      "guardrails": [
        "不能把不等可能事件当作等可能",
        "小学阶段重在直观比较与简单判断"
      ]
    },
    {
      "id": "multi_step",
      "name": "多步骤应用题（先求中间量）",
      "grades": [
        3,
        4,
        5,
        6
      ],
      "concepts": [
        "中间量",
        "分步计算",
        "数量关系链"
      ],
      "relations": [
        "先根据已知条件求中间量，再将中间量代入下一关系式",
        "每一步的结果都应标注单位并作为下一步的已知量"
      ],
      "cues": [
        "先求",
        "再求",
        "每箱",
        "每份",
        "还剩",
        "一共"
      ],
      "guardrails": [
        "必须显式列出中间量，不能直接跳到最终答案",
        "每一步计算结果必须能由题目条件推出"
      ]
    }
  ],
  "solution_contract": [
    "题目原文与抽取的已知条件必须保留。",
    "明确所求量，逐个标注数值、单位、对象和角色。",
    "说明为什么选用该数量关系或公式，不得只输出公式名。",
    "未知量公式变形必须展示。",
    "代入时保留单位并检查单位一致性。",
    "给出逐步算式；多步运算不能只给最终结果。",
    "用逆运算、代回公式、数量边界或题意关系独立检查答案。",
    "只有在题型、条件、计算和单位均可验证时才标记 verified。",
    "题意不清、数据角色不清或缺少必要条件时返回 unverified，不猜答案。",
    "数字出现顺序不代表数量角色；应按‘单价、总价、数量’等语义标签提取。",
    "单位换算必须先验证量纲一致；复合单位要同时统一分子和分母。",
    "遇到缺少必要条件、单位冲突或多种解释时，应返回unverified并说明缺少什么。"
  ]
}
